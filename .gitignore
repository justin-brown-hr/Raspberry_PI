# Unity .gitignore
#
# The Unity project lives in a subfolder ("The Catapult/"), not at the repo
# root, so every path pattern here is prefixed with **/ to match at any depth.
# A pattern containing a slash is otherwise anchored to this file's directory.

# ---- Unity-generated folders ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# ---- Generated IDE / solution files ----
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta

# Mono debug symbols shipped with SDKs are regenerable; drop them and their metas
*.mdb
*.mdb.meta

# Never ignore JetBrains editor plugin shipped in Assets
!**/[Aa]ssets/Plugins/Editor/JetBrains*

# ---- Build outputs ----
*.apk
*.aab
*.app
sysinfo.txt
crashlytics-build.properties

# .unitypackage files are usually exports, but this project ships one as a
# real asset with a tracked .meta - ignoring it would orphan that meta.
*.unitypackage
!**/[Aa]ssets/Common/F4A/F4AAssetBundle/AssetBundleCore.unitypackage

# ---- Addressables / streaming assets ----
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- External Dependency Manager (Play Services Resolver) output ----
# Resolved Android libs are regenerated by Assets > External Dependency Manager
**/[Aa]ssets/[Pp]lugins/[Aa]ndroid/*.aar
**/[Aa]ssets/[Pp]lugins/[Aa]ndroid/*Dependencies.txt
**/[Aa]ssets/GeneratedLocalRepo/
**/ProjectSettings/AndroidResolverDependencies.xml

# ---- Editors / OS ----
.vscode/
.idea/
# Visual Studio local cache + new-style solution files (regenerated by Unity/VS)
.vs/
*.slnx
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets (never commit) ----
credential*
*.env
!*.template.env
*.pem
*.key
id_rsa*
*.keystore
*.jks

# Unity licence files
*.alf
*.ulf

# ---- Node / JS tooling ----
node_modules/
package-lock.json.bak

# ---- Demo recordings and other video ----
# Cabinet demo clips are shared over chat, not source; they bloat the repo fast
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.wmv
*.flv

# ---- Screenshots from the automated playtest (PiBuild.BuildLinuxTest -cabinetTest) ----
cabinet-test/
**/cabinet-test/

# ---- Stray logs ----
*.log
